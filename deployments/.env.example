# ---------------------------------------------------------------------------
# Stack variables for deployments/compose.yaml.
#
# Copy to deployments/.env on the VPS. These are the values Compose itself
# substitutes — hostnames, image tags and build-time public URLs. The API's
# own secrets live in a separate file (ENV_FILE below), which keeps the
# credentials out of anything Compose prints.
#
#   cp deployments/.env.example deployments/.env
#   cp .env.example /etc/denisco/api.env    # then fill in the secrets
#
# ---------------------------------------------------------------------------

# Hostnames served by Caddy. Each needs a Cloudflare record pointing at the
# VPS (see deployments/README.md).
WEB_DOMAIN=deniscoglobalagroltd.com
WWW_DOMAIN=www.deniscoglobalagroltd.com
ADMIN_DOMAIN=admin.deniscoglobalagroltd.com
API_DOMAIN=api.deniscoglobalagroltd.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=info@deniscoglobalagroltd.com

# Public URLs baked into the frontend bundles at build time. They must match
# the hostnames above, with the scheme.
PUBLIC_API_URL=https://api.deniscoglobalagroltd.com
PUBLIC_WEB_URL=https://deniscoglobalagroltd.com

# Images built and pushed by CI. Pin TAG to a release (a commit SHA or a
# version) rather than leaving it at latest, so a rollback is a one-line
# change and `docker compose up -d` is repeatable.
REGISTRY=ghcr.io/dev-folabi

API_TAG=latest
WORKER_TAG=latest
OUTBOX_TAG=latest
WEB_TAG=latest
ADMIN_TAG=latest

# The API, worker and outbox publisher read their configuration from here.
# Keep it outside the repository checkout, owned by root, mode 600.
ENV_FILE=/etc/denisco/api.env

# ---------------------------------------------------------------------------
# Backups (deployments/backup.sh)
# ---------------------------------------------------------------------------
# Where dumps are written, and how many days of them to keep.
BACKUP_DIR=/var/backups/denisco
BACKUP_RETENTION_DAYS=14
