# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Build stage — compiles a static binary so the runtime image needs no
# toolchain or libc.
# ---------------------------------------------------------------------------
FROM golang:1.27-alpine AS build

WORKDIR /src

# Dependencies are copied first so the module cache survives source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath -ldflags="-s -w" \
    -o /out/worker ./cmd/worker

# ---------------------------------------------------------------------------
# Runtime stage — distroless-style Alpine with a non-root user.
# ---------------------------------------------------------------------------
FROM alpine:3.22

# ca-certificates is required for TLS to MongoDB Atlas, Paystack and Resend.
RUN apk add --no-cache ca-certificates curl \
    && addgroup -S denisco \
    && adduser -S -G denisco denisco

COPY --from=build /out/worker /usr/local/bin/worker

USER denisco

ENTRYPOINT ["/usr/local/bin/worker"]
