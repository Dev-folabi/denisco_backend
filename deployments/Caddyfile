# Caddy is the only service exposed to the internet. It terminates TLS and
# routes the three hostnames to the containers behind it:
#
#   {$WEB_DOMAIN}    → web   (Next.js customer site, port 3000)
#   {$ADMIN_DOMAIN}  → admin (Next.js dashboard, port 3001)
#   {$API_DOMAIN}    → api   (Go API, port 4000)
#
# Certificates are issued automatically over HTTP-01, which works through a
# proxied Cloudflare record. If the proxy is ever set to "DNS only" during
# issuance, or a wildcard certificate is wanted, build Caddy with the
# caddy-dns/cloudflare module and switch to the DNS-01 challenge instead.

{
	email {$ACME_EMAIL}

	# Cloudflare terminates the client's connection, so its edge addresses are
	# the ones Caddy sees. Trusting them keeps {remote_host} and Caddy's own
	# access logs honest.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Headers every site sends. HSTS is only safe because all three hostnames are
# served over TLS and nothing is published on plain HTTP.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Caddy's own version is not something visitors need.
		-Server
	}
}

# Headers and client-address handling for the upstreams.
#
# X-Real-IP is set from {client_ip}, which Caddy resolves from the forwarded
# chain only when the connection came from one of the trusted_proxies above,
# and from the peer address otherwise. That is the one value a caller cannot
# choose: a request that reaches the origin directly with a forged
# CF-Connecting-IP or X-Forwarded-For gets its real address here regardless.
#
# The incoming CF-Connecting-IP is dropped for the same reason — it is only
# meaningful when Cloudflare set it, and by then {client_ip} already carries
# it. The API trusts exactly one header, named by CLIENT_IP_HEADER, which is
# X-Real-IP in this deployment.
(upstream) {
	header_up X-Real-IP {client_ip}
	header_up -CF-Connecting-IP
	header_up X-Forwarded-Proto {scheme}
	header_up Host {host}
}

{$WEB_DOMAIN} {
	import security
	encode zstd gzip

	reverse_proxy web:3000 {
		import upstream
	}

	log {
		output stdout
		format json
	}
}

{$ADMIN_DOMAIN} {
	import security
	encode zstd gzip

	# The dashboard is never meant to be framed or indexed.
	header {
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy admin:3001 {
		import upstream
	}

	log {
		output stdout
		format json
	}
}

{$API_DOMAIN} {
	import security
	encode zstd gzip

	# CORS is decided by the API, which knows the exact allowed origins; Caddy
	# must not answer preflights itself or the two would disagree.
	reverse_proxy api:4000 {
		import upstream

		# A checkout that reaches Paystack and comes back can take a while.
		transport http {
			read_timeout 30s
			write_timeout 30s
		}

		# Liveness, not readiness. There is one API container, so there is
		# nothing to fail over to: taking it out of rotation would replace the
		# API's own error responses — which carry a request ID — with Caddy's
		# 502 page. /health/ready is for alerting, and reports Redis as
		# `degraded` rather than unready for the same reason.
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
