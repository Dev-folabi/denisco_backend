# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                    # development | test | production
APP_NAME=denisco-api
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# CORS — exact frontend origins. Wildcards are rejected at startup because the
# API serves credentialed (cookie) requests.
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576            # 1 MiB request-body cap

# The header the reverse proxy sets with the real client address. Rate limiting
# and the audit log use it, so it must be a single-address header the proxy
# writes itself — `X-Real-IP` behind the bundled Caddy configuration,
# `CF-Connecting-IP` if the API sits directly behind Cloudflare. Leave it empty
# when the API is reachable directly: anyone can send a header, and an accepted
# one lets a caller choose which rate-limit bucket counts them.
# X-Forwarded-For is rejected at startup, because which entry of its chain is
# the client depends on how many proxies appended to it.
CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# MongoDB (Atlas; TLS is negotiated through the mongodb+srv connection string)
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DATABASE=denisco
MONGODB_MAX_POOL_SIZE=20               # sized for a 2-vCPU VPS

# ---------------------------------------------------------------------------
# Redis (queue and selective caching)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Access tokens (EdDSA / Ed25519)
# ---------------------------------------------------------------------------
# JWT_ACCESS_SECRET must be at least 32 characters. The signing key is derived
# from it unless JWT_ED25519_SEED is set, which takes precedence and allows
# explicit key rotation. Generate a seed with:
#   openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_ED25519_SEED=
JWT_ACCESS_TTL=15m
JWT_ISSUER=denisco_backend
JWT_AUDIENCE=denisco_api

# ---------------------------------------------------------------------------
# Sessions and passwords
# ---------------------------------------------------------------------------
REFRESH_TOKEN_TTL=720h                 # 30 days
BCRYPT_COST=12                         # benchmark on the production VPS
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72                 # bcrypt's input limit
PASSWORD_RESET_TTL=1h
PASSWORD_RESET_MAX_PER_WINDOW=3
PASSWORD_RESET_WINDOW=1h

# Refresh-token cookie. COOKIE_SECURE must be true in production (enforced at
# startup). SameSite=lax is correct when the API and frontends share a
# registrable domain (api./www./admin.denisco.com).
REFRESH_COOKIE_NAME=denisco_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax                    # lax | strict | none

# Development aid only: returns the password-reset token in the
# forgot-password response so the flow can be completed without email.
# Ignored when APP_ENV=production.
AUTH_EXPOSE_RESET_TOKEN=false

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_SIGNUP_PER_HOUR=10
RATE_LIMIT_RESET_PER_HOUR=3

# ---------------------------------------------------------------------------
# Payments (Paystack)
# ---------------------------------------------------------------------------
# The customer is returned to WEB_ORIGIN/payment/callback after checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ---------------------------------------------------------------------------
# Media (ImageKit)
# ---------------------------------------------------------------------------
# Product images are uploaded straight from the admin browser using a
# short-lived signature issued by the API; the private key never leaves here.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# Receives a copy of consultation booking notices so farm staff see new
# appointments, and the late-payment notices that ask for a refund decision.
# Leave empty to disable both.
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# Jobs run concurrently on a 2-vCPU VPS shared with the API, so this stays low.
WORKER_CONCURRENCY=5
# How long an unpaid order holds its stock before the worker returns it.
RESERVATION_EXPIRY=45m

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info                         # debug | info | warn | error
